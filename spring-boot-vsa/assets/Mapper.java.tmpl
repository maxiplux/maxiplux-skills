{{MAPPER_IMPORTS}}
import org.springframework.stereotype.Component;

/**
 * Translates between {@link {{Feature}}} entities and DTO records.
 *
 * <p>Entities never cross the HTTP boundary. Every handler that returns
 * to the controller maps to a response record through this class.
 */
@Component
public class {{Feature}}Mapper {

{{MAPPER_METHODS}}
    public {{Feature}}Response toResponse({{Feature}} entity) {
        return new {{Feature}}Response(
                entity.getId(),
                entity.getName(),
                // TODO: map remaining fields to the response record
                entity.getCreatedAt(),
                entity.getUpdatedAt()
        );
    }
}
