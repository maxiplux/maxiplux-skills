/**
 * Handler for the "list {{feature}}s" use case.
 *
 * <p>Returns a {@link Page} — never an unbounded {@code List}.
 * Read-only transaction signals JPA to skip dirty-checking overhead.
 */
@Service
@RequiredArgsConstructor
@Slf4j
public class List{{Feature}}Handler {

    private final {{Feature}}Repository {{feature}}Repository;
    private final {{Feature}}Mapper {{feature}}Mapper;

