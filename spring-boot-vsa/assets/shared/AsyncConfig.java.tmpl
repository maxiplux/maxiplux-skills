package {{BasePackage}}.shared.config;

import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.scheduling.annotation.EnableAsync;
import org.springframework.scheduling.concurrent.ThreadPoolTaskExecutor;

import java.util.concurrent.Executor;

/**
 * Async executor for {@code @Async("taskExecutor")} event listeners and background work.
 *
 * <p>The bean name {@code taskExecutor} is part of the contract — listeners reference it
 * by name. Tune pool sizes to the workload; these defaults suit light background work.
 *
 * <p>When JSON logging is scaffolded, the executor registers {@code MdcTaskDecorator}
 * (same package) so MDC correlation ids survive the hop onto async threads.
 */
@Configuration
@EnableAsync
public class AsyncConfig {

    @Bean(name = "taskExecutor")
    public Executor taskExecutor() {
        ThreadPoolTaskExecutor executor = new ThreadPoolTaskExecutor();
        executor.setCorePoolSize(4);
        executor.setMaxPoolSize(8);
        executor.setQueueCapacity(100);
        executor.setThreadNamePrefix("app-async-");
{{TASK_DECORATOR_WIRING}}
        executor.initialize();
        return executor;
    }
}
