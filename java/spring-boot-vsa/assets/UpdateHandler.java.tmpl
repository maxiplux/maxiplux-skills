/**
 * Handler for the "update {{feature}}" use case.
 *
 * <p>Dirty-checking via JPA persistence context — no explicit {@code save} call needed
 * because the entity is managed while the transaction is open.
 */
@Service
@RequiredArgsConstructor
@Slf4j
public class Update{{Feature}}Handler {

    private final {{Feature}}Repository {{feature}}Repository;
    private final {{Feature}}Mapper {{feature}}Mapper;

    @Transactional
    public {{Feature}}Response handle(Long id, Update{{Feature}}Request request) {
